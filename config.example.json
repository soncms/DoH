{
  "listen": "127.0.0.1:5300",
  "interception": "windivert",
  "dpi_bypass": {
    "enabled": false,
    "backend": "embedded-zapret2",
    "capture_mode": "default",
    "executable": "",
    "arguments": [],
    "targets": [],
    "exclude": ["localhost", "*.local"],
    "fail_open": true,
    "auto_restart": true
  },
  "timeout": "5s",
  "service_auto_start": false,
  "upstreams": [
    {
      "name": "SonCMS",
      "type": "DNS over HTTPS",
      "url": "https://dns.soncms.net/dns-query/sondns"
    },
    {
      "name": "NextDNS",
      "type": "DNS over HTTPS",
      "url": "https://dns.nextdns.io/2e2e3c",
      "bootstrap": ["45.90.28.0:443", "45.90.30.0:443", "[2a07:a8c0::]:443", "[2a07:a8c1::]:443"]
    }
  ],
  "log_file": "data/sondns.log"
}

